<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Darkroom</AssemblyName>
    <RootNamespace>Darkroom</RootNamespace>
    <ApplicationIcon>darkroom.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>Darkroom</Product>
    <Description>Darkroom photo editor</Description>

    <!-- Portable single-file build: one Darkroom.exe, no .NET install needed on the target PC -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The editor UI is compiled into the exe -->
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="Darkroom.index.html" />
    <Resource Include="darkroom.ico" />
  </ItemGroup>

</Project>
